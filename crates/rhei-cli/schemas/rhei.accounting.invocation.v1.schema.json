{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "rhei.accounting.invocation.v1",
  "title": "Rhei accounting invocation record v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "invocation_id",
    "task_id",
    "state",
    "visit",
    "agent",
    "started_at",
    "ended_at",
    "extraction_status",
    "scope",
    "tokens",
    "pricing"
  ],
  "properties": {
    "schema": { "const": "rhei.accounting.invocation.v1" },
    "invocation_id": { "type": "string" },
    "task_id": { "type": "string" },
    "state": { "type": "string" },
    "visit": { "type": "integer", "minimum": 0 },
    "target_slug": { "type": "string" },
    "agent": { "type": "string" },
    "provider": { "type": "string" },
    "model": { "type": "string" },
    "started_at": { "type": "string" },
    "ended_at": { "type": "string" },
    "duration_ms": { "type": "integer", "minimum": 0 },
    "cli_session": { "$ref": "#/$defs/cli_session" },
    "extraction_status": {
      "enum": [
        "measured",
        "unsupported-agent",
        "extractor-unavailable",
        "extractor-failed",
        "no-usage-emitted"
      ]
    },
    "scope": {
      "enum": ["aggregate-agent-process", "provider-call", "child-invocation"]
    },
    "tokens": { "$ref": "#/$defs/tokens" },
    "pricing": { "$ref": "#/$defs/pricing" }
  },
  "$defs": {
    "cli_session": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "store_path": { "type": "string", "minLength": 1 }
      }
    },
    "measured_dimension": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "source"],
      "properties": {
        "value": { "type": "integer", "minimum": 0 },
        "source": { "type": "string", "minLength": 1 }
      }
    },
    "unavailable_dimension": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": { "enum": ["unsupported", "omitted", "unknown"] }
      }
    },
    "dimension": {
      "oneOf": [
        { "$ref": "#/$defs/measured_dimension" },
        { "$ref": "#/$defs/unavailable_dimension" }
      ]
    },
    "token_side": {
      "type": "object",
      "additionalProperties": false,
      "required": ["total", "cached_read", "cache_write"],
      "properties": {
        "total": { "$ref": "#/$defs/dimension" },
        "cached_read": { "$ref": "#/$defs/dimension" },
        "cache_write": { "$ref": "#/$defs/dimension" }
      }
    },
    "tokens": {
      "type": "object",
      "additionalProperties": false,
      "required": ["total", "input", "output"],
      "properties": {
        "total": { "$ref": "#/$defs/dimension" },
        "input": { "$ref": "#/$defs/token_side" },
        "output": { "$ref": "#/$defs/token_side" }
      }
    },
    "pricing": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "currency", "amount_micro", "priced_amount_micro", "price_book_id"],
          "properties": {
            "status": { "const": "priced" },
            "currency": { "type": "string" },
            "amount_micro": { "type": "integer", "minimum": 0 },
            "priced_amount_micro": { "type": "integer", "minimum": 0 },
            "price_book_id": { "type": "string" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "currency", "priced_amount_micro", "price_book_id"],
          "properties": {
            "status": { "const": "partial-price" },
            "currency": { "type": "string" },
            "priced_amount_micro": { "type": "integer", "minimum": 0 },
            "price_book_id": { "type": "string" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "currency", "price_book_id"],
          "properties": {
            "status": { "const": "unpriced" },
            "currency": { "type": "string" },
            "price_book_id": { "type": "string" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status"],
          "properties": {
            "status": { "const": "not-applicable" }
          }
        }
      ]
    }
  }
}
