{
  "defaults": {
    "agent": "mock",
    "agent_timeout": "5m"
  },
  "agents": {
    "mock": {
      "command": [
        "python3",
        "-c",
        "import os, pathlib, runpy; runpy.run_path(str(pathlib.Path(os.environ['RHEI_ROOT']) / 'workflow.py'), run_name='__main__')"
      ],
      "prompt_flag": "--prompt",
      "timeout": "5m"
    }
  }
}
