{
  "defaults": {
    "agent": "mock-agent",
    "agent_mode": "yolo",
    "model": "mock-fast",
    "agent_timeout": "30s",
    "program_timeout": "30s"
  },
  "agents": {
    "mock-agent": {
      "command": [
        "python3",
        "-c",
        "import pathlib, re, runpy, sys; prompt = next((sys.argv[i + 1] for i, arg in enumerate(sys.argv[:-1]) if arg == '--prompt'), ''); root = re.search(r'(?m)^- This rhei: `([^`]+)`', prompt); root or sys.exit('prompt has no Rhei execution root'); runpy.run_path(str(pathlib.Path(root.group(1)) / 'bin' / 'mock-agent.py'), run_name='__main__')"
      ],
      "prompt_flag": "--prompt",
      "model_flag": "--model",
      "skill_flag": "--skill",
      "stdin_prompt": false,
      "timeout": "30s",
      "modes": {
        "yolo": [
          "--mode",
          "yolo"
        ],
        "slow": [
          "--mode",
          "slow"
        ]
      },
      "session": {
        "resume": {
          "flag": "--resume"
        },
        "fork": {
          "flag": "--fork"
        },
        "interactive": {},
        "session_dir_flag": "--session-dir",
        "no_session_flag": "--no-session",
        "layout": {
          "kind": "FlatById",
          "ext": "jsonl"
        }
      }
    }
  },
  "models": {
    "mock-fast": {
      "provider": "mock",
      "model": "mock-fast",
      "default_agent": "mock-agent"
    },
    "ui-specialist": {
      "provider": "mock",
      "model": "ui-specialist",
      "default_agent": "mock-agent"
    }
  },
  "skills": {
    "ui-fixture": {
      "path": "./skills/ui-fixture",
      "description": "Mock skill used by the canonical UI fixture."
    }
  },
  "mcp_servers": {
    "mock-mcp": {
      "command": [
        "false"
      ],
      "startup_timeout": "3s"
    }
  }
}
